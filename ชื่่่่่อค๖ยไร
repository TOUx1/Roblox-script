-- ระบบ Auto Muscle
local muscleConn
local function equipWeight()
    local char = lp.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    -- หา Weight ในตัวก่อน
    local tool = char:FindFirstChild("Weight")
    if tool and tool:IsA("Tool") then
        hum:EquipTool(tool)
        return
    end
    
    -- หาในกระเป๋า
    local bp = lp:FindFirstChild("Backpack")
    if bp then
        tool = bp:FindFirstChild("Weight")
        if tool and tool:IsA("Tool") then
            hum:EquipTool(tool)
        end
    end
end

local function startMuscle()
    if muscleConn then muscleConn:Disconnect() end
    muscleConn = RunService.Heartbeat:Connect(function()
        if not states.autoMuscle then return end
        equipWeight()
        pcall(function()
            local ev = lp:FindFirstChild("muscleEvent")
            if ev then
                ev:FireServer("rep")
            end
        end)
        task.wait(settings.muscleSpeed)
    end)
end

local function stopMuscle()
    if muscleConn then
        muscleConn:Disconnect()
        muscleConn = nil
    end
end

muscleToggle.MouseButton1Click:Connect(function()
    states.autoMuscle = not states.autoMuscle
    if states.autoMuscle then
        muscleToggle.Text = "ON"
        muscleToggle.BackgroundColor3 = Color3.fromRGB(0,180,80)
        startMuscle()
        playSound(9113769748, 0.35)
    else
        muscleToggle.Text = "OFF"
        muscleToggle.BackgroundColor3 = Color3.fromRGB(70,70,85)
        stopMuscle()
        playSound(9113769748, 0.25)
    end
end)

-- ระบบ Auto Crystal
local crystalConn
local function startCrystal()
    if crystalConn then crystalConn:Disconnect() end
    crystalConn = RunService.Heartbeat:Connect(function()
        if not states.autoCrystal then return end
        pcall(function()
            local remote = ReplicatedStorage:FindFirstChild("rEvents")
            if remote then
                remote = remote:FindFirstChild("openCrystalRemote")
                if remote then
                    remote:InvokeServer("openCrystal", "Unlimited Secrets Crystal", 1)
                end
            end
        end)
        task.wait(settings.crystalSpeed)
    end)
end

local function stopCrystal()
    if crystalConn then
        crystalConn:Disconnect()
        crystalConn = nil
    end
end

