-- เปิด/ปิด GUI
local function toggleGui()
    states.guiVisible = not states.guiVisible
    if states.guiVisible then
        main.Visible = true
        TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundTransparency = 0}):Play()
        playSound(9113769748, 0.3)
    else
        TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
        task.wait(0.2)
        main.Visible = false
        playSound(9113769748, 0.2)
    end
end

toggleBtn.MouseButton1Click:Connect(toggleGui)
closeBtn.MouseButton1Click:Connect(toggleGui)

-- เอฟเฟกต์ hover
local function addHover(btn, normal, hover)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = hover}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = normal}):Play()
    end)
end

