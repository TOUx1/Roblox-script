local function checkPremiumFromURL()
	local isPremium = false
	pcall(function()
		local response = game:HttpGet(RAW_WHITELIST_URL)
		if response and response ~= "" then
			local data = HttpService:JSONDecode(response)
			if data and data.PremiumUsers then
				for _, user in ipairs(data.PremiumUsers) do
					local nameMatch = user.Username and string.lower(user.Username) == string.lower(LocalPlayer.Name)
					local idMatch = user.UserId and tonumber(user.UserId) == LocalPlayer.UserId and tonumber(user.UserId) ~= 0
					if nameMatch or idMatch then
						isPremium = true
						break
					end
				end
			end
		end
	end)
	return isPremium
end

