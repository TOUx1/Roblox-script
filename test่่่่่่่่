	-- 🪨 AUTO PUNCH ROCK FUNCTIONS (ปรับแต่งย่อขนาด สลับมือซ้าย-ขวา คืนค่าเดิม)
	local function saveOriginalRockData(rockModel)
		if not rockModel then return end
		for _, part in ipairs(rockModel:GetDescendants()) do
			if part:IsA("BasePart") and not originalRockData[part] then
				originalRockData[part] = {
					CFrame = part.CFrame,
					Size = part.Size,
					Transparency = part.Transparency,
					CanCollide = part.CanCollide
				}
			end
		end
	end

	local function restoreOriginalRockData()
		for part, data in pairs(originalRockData) do
			if part and part.Parent then
				pcall(function()
					part.CanCollide = data.CanCollide
					part.Transparency = data.Transparency
					part.Size = data.Size
					part.CFrame = data.CFrame
					if part:IsA("BasePart") then
						part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					end
				end)
			end
		end
		table.clear(originalRockData)
	end

	local function modifyAndMoveRock(rockModel, targetHand)
		if not rockModel or not targetHand then return end
		saveOriginalRockData(rockModel)
		
		rockAngle = (rockAngle + 15) % 360
		local targetCFrame = targetHand.CFrame * CFrame.Angles(0, math.rad(rockAngle), math.rad(rockAngle))
		for _, part in ipairs(rockModel:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.Transparency = 1
				part.Size = Vector3.new(0.001, 0.001, 0.001)
				part.CFrame = targetCFrame
				-- ป้องกันแรงเหวี่ยงจากฟิสิกส์ Roblox (Anti Velocity Lag/Launch)
				part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
			elseif part:IsA("Decal") or part:IsA("Texture") then
				part.Transparency = 1
			elseif part:IsA("SpecialMesh") or part:IsA("BlockMesh") then
				part.Scale = Vector3.new(0.001, 0.001, 0.001)
			end
		end
	end

	local function startAutoRock()
		autoRockEnabled = true
		-- ⭐ Equip "Punch" tool immediately
		equipTool("Punch")
		autoRockConn = RunService.Heartbeat:Connect(function()
