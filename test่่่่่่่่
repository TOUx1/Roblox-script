	-- 🛠️ FIXED ANTI-KNOCKBACK
	local function setupAntiKnockback(char)
		if not char then return end
		local humanoid = char:WaitForChild("Humanoid", 5)
		local root = char:WaitForChild("HumanoidRootPart", 5)
		if not humanoid or not root then return end
		lastHealth = humanoid.Health
		if healthConn then healthConn:Disconnect() end
		healthConn = humanoid.HealthChanged:Connect(function(newHealth)
			if antiKnockbackEnabled and newHealth < lastHealth then
				if not isKnockbackLocked then
					isKnockbackLocked = true
					root.Anchored = true
					task.delay(0.5, function()
						if root and root.Parent then root.Anchored = false end
						isKnockbackLocked = false
					end)
				end
			end
			lastHealth = newHealth
		end)
	end

	LocalPlayer.CharacterAdded:Connect(function(char)
		setupAntiKnockback(char)
	end)
	if LocalPlayer.Character then setupAntiKnockback(LocalPlayer.Character) end

	task.spawn(function()
		while true do
			if not isMonitoringRebirthTp and LocalPlayer.Character then
				local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if root then savedPosBeforeRebirth = root.CFrame end
			end
			task.wait(0.1)
		end
	end)

	local function setupRebirthTracker(leaderstats)
		if not leaderstats then return end
		local rebirths = leaderstats:WaitForChild("Rebirths", 5)
		if not rebirths then return end
		local currentCount = rebirths.Value
		rebirths.Changed:Connect(function(newVal)
			if antiRebirthTpEnabled and newVal > currentCount then
				local returnCFrame = savedPosBeforeRebirth
				isMonitoringRebirthTp = true
				local startTime = os.clock()
				task.spawn(function()
					while os.clock() - startTime < 6 do
						local char = LocalPlayer.Character
						local root = char and char:FindFirstChild("HumanoidRootPart")
						if root and returnCFrame then
							if (root.Position - returnCFrame.Position).Magnitude > 10 then
								task.wait(0.1)
								root.CFrame = returnCFrame
							end
						end
						task.wait(0.05)
					end
					isMonitoringRebirthTp = false
				end)
			end
			currentCount = newVal
		end)
	end

	local leaderstatsObj = LocalPlayer:FindFirstChild("leaderstats")
	if leaderstatsObj then setupRebirthTracker(leaderstatsObj) end
	LocalPlayer.ChildAdded:Connect(function(child)
		if child.Name == "leaderstats" then setupRebirthTracker(child) end
	end)

