	local function getMuscleEvent()
		return LocalPlayer:FindFirstChild("muscleEvent")
	end

	local function equipTool(toolName)
		local char = LocalPlayer.Character
		if not char then return false end
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not humanoid then return false end
		local tool = LocalPlayer.Backpack:FindFirstChild(toolName) or char:FindFirstChild(toolName)
		if tool then
			humanoid:EquipTool(tool)
			return true
		end
		return false
	end

	local function fireMuscle()
		local event = getMuscleEvent()
		if event then
			pcall(function() event:FireServer("rep") end)
		end
	end

	local function startFarming()
		if not farmTool then return end
		farmEnabled = true
		farmConn = RunService.Heartbeat:Connect(function()
			if not farmEnabled then return end
			if not equipTool(farmTool) then
