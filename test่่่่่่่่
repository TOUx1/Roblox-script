			local rightHand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or char:FindFirstChild("HumanoidRootPart")
			local leftHand = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm") or char:FindFirstChild("HumanoidRootPart")
			local targetHand = rockHandToggle and leftHand or rightHand
			local machines = workspace:FindFirstChild("machinesFolder")
			if machines then
				local rock = machines:FindFirstChild(selectedRockName)
				if rock then
					modifyAndMoveRock(rock, targetHand)
				end
			end
			local event = getMuscleEvent()
			if event then
				pcall(function()
					event:FireServer("punch", "rightHand")
					event:FireServer("punch", "leftHand")
				end)
			end
			task.wait(0.01)
		end)
	end

